<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CineLibraryEssentials.Views.RenameStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:util="using:CineLibraryEssentials.Utilities"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="OnAcceleratorSelectAll" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">

            <!-- ============ Warning InfoBar ============ -->
            <InfoBar Grid.Row="0"
                     x:Name="WarningInfoBar"
                     Severity="Informational"
                     Title="Tip"
                     Message="Already-clean files are hidden by default — toggle 'Modified only' off to see them. Review Low / Medium confidence rows carefully; you have a 30-second Undo after each rename batch."
                     IsOpen="True"
                     IsClosable="True"
                     CloseButtonClick="OnWarningInfoBarClosed" />

            <!-- ============ Source folder + recursive + format (single compact row) ============ -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Source"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         x:Name="SourceFolderText"
                         IsReadOnly="True"
                         PlaceholderText="Drop a folder here or click Browse"
                         VerticalAlignment="Center" />
                <SplitButton Grid.Column="2"
                             x:Name="BrowseButton"
                             Click="OnBrowseClick"
                             VerticalAlignment="Center"
                             ToolTipService.ToolTip="Pick source folder. Click ▾ for recent folders.">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="RecentFoldersFlyout" Placement="Bottom" />
                    </SplitButton.Flyout>
                </SplitButton>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Wizard mode dropdown — controls how files are parsed -->
                    <ComboBox SelectedItem="{Binding WizardMode, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              MinWidth="110"
                              ToolTipService.ToolTip="How files are parsed: Auto detects per-file, Movies forces all to be movies, TV Shows treats every file as an episode (rows without S/E patterns get flagged).">
                        <x:String>Auto</x:String>
                        <x:String>Movies</x:String>
                        <x:String>TvShows</x:String>
                    </ComboBox>
                    <CheckBox Content="Subfolders"
                              IsChecked="{Binding IsRecursive, Mode=TwoWay}"
                              ToolTipService.ToolTip="Recursively scan all subfolders" />
                    <CheckBox Content="Rename folder"
                              IsChecked="{Binding RenameParentFolder, Mode=TwoWay}"
                              ToolTipService.ToolTip="Also rename the containing folder when a movie sits in its own subfolder" />
                    <CheckBox Content="Clean metadata"
                              IsChecked="{Binding CleanEmbeddedMetadata, Mode=TwoWay}"
                              ToolTipService.ToolTip="Also clean the file's embedded title/comment fields (kills the website link in VLC's titlebar)" />
                </StackPanel>
                <ComboBox Grid.Column="4"
                          SelectedItem="{Binding OutputTemplate, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="130"
                          ToolTipService.ToolTip="Output filename format">
                    <x:String>{Title} ({Year})</x:String>
                    <x:String>{Year} - {Title}</x:String>
                </ComboBox>
            </Grid>

            <!-- ============ Toolbar: search, filter, find/replace ============ -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0"
                         PlaceholderText="🔍 Search"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="180"
                         VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          x:Name="AllCheckBox"
                          Content="All"
                          Click="OnSelectAllClick"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Select all rows (Ctrl+A)" />
                <CheckBox Grid.Column="2"
                          x:Name="NoneCheckBox"
                          Content="None"
                          Click="OnSelectNoneClick"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Deselect all rows" />

                <ComboBox Grid.Column="4"
                          SelectedItem="{Binding ConfidenceFilter, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="130"
                          ToolTipService.ToolTip="Filter by confidence">
                    <x:String>All</x:String>
                    <x:String>High</x:String>
                    <x:String>Medium</x:String>
                    <x:String>Low</x:String>
                    <x:String>Warnings</x:String>
                    <x:String>Needs renaming</x:String>
                </ComboBox>

                <ToggleButton Grid.Column="5"
                              IsChecked="{Binding HideUnchanged, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Hide rows whose cleaned name already matches the original">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE71C;" FontSize="13" />
                        <TextBlock Text="Modified only" FontSize="12" />
                    </StackPanel>
                </ToggleButton>

                <TextBox Grid.Column="6"
                         PlaceholderText="Find"
                         Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="100"
                         VerticalAlignment="Center" />
                <TextBox Grid.Column="7"
                         PlaceholderText="Replace"
                         Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="100"
                         VerticalAlignment="Center" />
                <Button Grid.Column="8"
                        Content="Replace"
                        Click="OnFindReplaceClick"
                        VerticalAlignment="Center" />

                <Button Grid.Column="9"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="More actions">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Apply Smart Title Case" Click="OnApplyTitleCaseClick" />
                            <MenuFlyoutItem Text="Reset Auto-Cleaning" Click="OnResetClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- ============ Sortable column headers ============ -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="36,*,*,80,32,32"
                  Padding="10,6"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="4,4,0,0">
                <TextBlock Text="" />
                <Button Grid.Column="1"
                        x:Name="SortByOriginalButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="2,0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Click="OnSortOriginalClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Original" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon x:Name="SortOriginalIcon" Glyph="" FontSize="10" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        x:Name="SortByCleanedButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="2,0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Click="OnSortCleanedClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Cleaned" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon x:Name="SortCleanedIcon" Glyph="" FontSize="10" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        x:Name="SortByConfidenceButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="2,0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Click="OnSortConfidenceClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Confidence" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon x:Name="SortConfidenceIcon" Glyph="&#xE74B;" FontSize="10" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ File list ============ -->
            <ListView Grid.Row="4"
                      x:Name="FilePreviewList"
                      SelectionMode="None"
                      ItemsSource="{Binding FilePreviews}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      CornerRadius="0,0,4,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="MinHeight" Value="48" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="36,*,*,80,32,32">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Search TMDb..."
                                                    Click="OnContextSearchTmdbClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Apply Title Case"
                                                    Click="OnContextTitleCaseClick" />
                                    <MenuFlyoutItem Text="Reset Cleaning"
                                                    Click="OnContextResetClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Open Containing Folder"
                                                    Click="OnContextOpenFolderClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Remove from List"
                                                    Click="OnContextRemoveClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0" Spacing="1">
                                <TextBlock util:RichTextBehavior.Segments="{Binding OriginalDiffSegments}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           ToolTipService.ToolTip="{Binding OriginalName}" />
                                <TextBlock Text="{Binding FileSizeDisplay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="4,0" VerticalAlignment="Center" Spacing="2">
                                <TextBox Text="{Binding CleanedName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         FontSize="12" />
                                <!-- Edition chip — visible only when an edition was detected -->
                                <Border CornerRadius="4"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        Visibility="{Binding Edition, Converter={StaticResource StringNonEmptyToVisibilityConverter}}"
                                        ToolTipService.ToolTip="Detected edition — written to NFO as &lt;edition&gt;">
                                    <TextBlock Text="{Binding Edition}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="10" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="3"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="4,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding ConfidenceLabel, Converter={StaticResource ConfidenceColorConverter}}" />
                                </Border.Background>
                                <TextBlock Text="{Binding ConfidenceLabel}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="10" />
                            </Border>

                            <FontIcon Grid.Column="4"
                                      Glyph="&#xE7BA;"
                                      FontSize="14"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTipService.ToolTip="{Binding WarningMessage}" />

                            <Button Grid.Column="5"
                                    Tag="{Binding}"
                                    Click="OnTmdbSearchClick"
                                    Width="28" Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Search TMDb">
                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ============ Footer: stats + Rename button ============ -->
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                <TextBlock Text="{Binding StatsSummary}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{Binding IsLoading}" Width="18" Height="18"
                                  VerticalAlignment="Center" />
                    <Button x:Name="RenameButton"
                            Content="Rename Selected"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnRenameInPlaceClick"
                            ToolTipService.ToolTip="Rename the checked files in their current folder" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ Drag-drop overlay (full-page when dragging) ============ -->
        <Border x:Name="DragOverlay"
                Background="#CC000000"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="56" Foreground="White" />
                <TextBlock Text="Drop folder to load"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
