<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CineLibraryEssentials.Views.ScrapingStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Click="OnAddFolderClick"
                        ToolTipService.ToolTip="Add a movie folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Add Folder" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Click="OnClearAllClick"
                        ToolTipService.ToolTip="Clear the list (does not touch any files)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Clear" FontSize="12" />
                    </StackPanel>
                </Button>
                <ToggleButton Grid.Column="2"
                              x:Name="ListViewToggle"
                              IsChecked="False"
                              Click="OnViewToggleClick"
                              ToolTipService.ToolTip="Switch to list view">
                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                </ToggleButton>
                <TextBlock Grid.Column="3"
                           x:Name="StatusText"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="8,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="4"
                        Content="Scrape Selected (auto)"
                        Click="OnScrapeSelectedClick"
                        ToolTipService.ToolTip="Auto-scrape every checked movie using the first TMDb match" />
            </Grid>

            <!-- Content (card grid OR list OR empty state) -->
            <Grid Grid.Row="1"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="2">

                <!-- Card grid (default) -->
                <ScrollViewer x:Name="GridScroll"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MovieGrid"
                                  ItemsSource="{Binding MovieFolders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapGrid xmlns:controls="using:Microsoft.UI.Xaml.Controls"
                                                   Orientation="Horizontal"
                                                   ItemWidth="200"
                                                   ItemHeight="320" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Search TMDb..."
                                                            Click="OnContextScrapeClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open Folder"
                                                            Click="OnContextOpenClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Remove from List"
                                                            Click="OnContextRemoveClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid RowDefinitions="200,Auto,*">

                                        <!-- Poster (or placeholder) -->
                                        <Grid Grid.Row="0">
                                            <Image Source="{Binding PosterPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding PosterPath, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                                            <Border Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                                    Visibility="{Binding PosterPath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                                                <FontIcon Glyph="&#xE8B2;"
                                                          FontSize="50"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                            <!-- Selection checkbox -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      Margin="6"
                                                      Background="#88000000" />
                                            <!-- Status pill bottom-left -->
                                            <Border CornerRadius="10"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="6">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Status, Converter={StaticResource ScrapingStatusColorConverter}}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="10" />
                                            </Border>
                                        </Grid>

                                        <!-- Title + year -->
                                        <StackPanel Grid.Row="1" Padding="10,8,10,4" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding FolderPath}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding FolderPath}" />
                                        </StackPanel>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Padding="10,4,10,10"
                                                    HorizontalAlignment="Stretch">
                                            <Button Tag="{Binding}"
                                                    Click="OnScrapeRowClick"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                    <TextBlock Text="Scrape" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Tag="{Binding}"
                                                    Click="OnOpenRowClick"
                                                    Padding="8,4"
                                                    ToolTipService.ToolTip="Open folder">
                                                <FontIcon Glyph="&#xE838;" FontSize="11" />
                                            </Button>
                                            <Button Tag="{Binding}"
                                                    Click="OnRemoveRowClick"
                                                    Padding="8,4"
                                                    ToolTipService.ToolTip="Remove from list">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- List view (toggle) -->
                <ListView x:Name="MovieList"
                          SelectionMode="None"
                          ItemsSource="{Binding MovieFolders}"
                          Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="36,*,140,Auto">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Search TMDb..." Click="OnContextScrapeClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open Folder" Click="OnContextOpenClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from List" Click="OnContextRemoveClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FolderPath}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding FolderPath}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Status, Converter={StaticResource ScrapingStatusColorConverter}}" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="White"
                                               FontWeight="SemiBold" FontSize="10" />
                                </Border>
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Tag="{Binding}" Click="OnScrapeRowClick" Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                                            <TextBlock Text="Scrape" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{Binding}" Click="OnOpenRowClick" Padding="8,2"
                                            ToolTipService.ToolTip="Open folder">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    </Button>
                                    <Button Tag="{Binding}" Click="OnRemoveRowClick" Padding="8,2"
                                            ToolTipService.ToolTip="Remove from list">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty-state -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            Padding="24"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE721;" FontSize="56"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No movies in the list yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Add a movie folder, drop one onto the window, or come back from Step 2."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="380" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,4,0,0">
                <Button x:Name="SaveButton"
                        Content="Done"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>

        <!-- Drag-drop overlay -->
        <Border x:Name="DragOverlay"
                Background="#CC000000"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="56" Foreground="White" />
                <TextBlock Text="Drop folder to add"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
