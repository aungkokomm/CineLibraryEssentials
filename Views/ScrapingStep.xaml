<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CineLibraryEssentials.Views.ScrapingStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                <Button Click="OnAddFolderClick"
                        ToolTipService.ToolTip="Add a movie folder (recursively scans for videos)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Add Folder" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Click="OnClearAllClick"
                        ToolTipService.ToolTip="Clear the list (does not touch any files)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Clear" FontSize="12" />
                    </StackPanel>
                </Button>
                <CheckBox Grid.Column="2"
                          x:Name="AllCheckBox"
                          Content="All"
                          Click="OnSelectAllClick"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Select all movies" />
                <CheckBox Grid.Column="3"
                          x:Name="NoneCheckBox"
                          Content="None"
                          Click="OnSelectNoneClick"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Deselect all movies" />
                <ToggleButton Grid.Column="4"
                              x:Name="ListViewToggle"
                              IsChecked="False"
                              Click="OnViewToggleClick"
                              ToolTipService.ToolTip="Switch to list view">
                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                </ToggleButton>
                <ComboBox Grid.Column="4"
                          SelectedItem="{Binding WizardMode, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="110"
                          Margin="40,0,0,0"
                          ToolTipService.ToolTip="Filter cards: Auto shows everything, Movies hides TV shows, TvShows hides movies. Synced with Step 1's mode.">
                    <x:String>Auto</x:String>
                    <x:String>Movies</x:String>
                    <x:String>TvShows</x:String>
                </ComboBox>
                <TextBlock Grid.Column="5"
                           x:Name="StatusText"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="8,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                    <Button Content="Fill gaps only"
                            Click="OnScrapeGapsClick"
                            ToolTipService.ToolTip="Verify library — auto-scrape every folder that's missing the NFO, poster, fanart, or actor photos. Skips folders that are already complete." />
                    <Button Content="Scrape Selected (auto)"
                            Click="OnScrapeSelectedClick"
                            ToolTipService.ToolTip="Auto-scrape every checked movie using the first TMDb match" />
                </StackPanel>
            </Grid>

            <!-- Content (card grid OR list OR empty state) -->
            <Grid Grid.Row="1"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="2">

                <!-- Card grid (default) — ItemsRepeater + UniformGridLayout for true auto-fit -->
                <ScrollViewer x:Name="MovieGrid"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="6">
                    <ItemsRepeater ItemsSource="{Binding MovieFolders}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="140"
                                               MinItemHeight="260"
                                               MinRowSpacing="6"
                                               MinColumnSpacing="6"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Height="260"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        DoubleTapped="OnCardDoubleTapped"
                                        Tag="{Binding}">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="View details..."
                                                        Click="OnContextViewDetailsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Search TMDb..."
                                                        Click="OnContextScrapeClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open Folder"
                                                        Click="OnContextOpenClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from List"
                                                        Click="OnContextRemoveClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid RowDefinitions="170,*,Auto">

                                    <!-- Poster (or placeholder) -->
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding PosterPath}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding PosterPath, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                                        <Border Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                                Visibility="{Binding PosterPath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE8B2;"
                                                      FontSize="36"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <!-- Selection checkbox in its own backdrop so it stays visible on any poster -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#99000000"
                                                CornerRadius="3"
                                                Padding="2"
                                                Margin="4">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      MinWidth="0"
                                                      Padding="0" />
                                        </Border>
                                        <!-- Status pill bottom-left, with inline spinner while scraping -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="4">
                                            <ProgressRing Width="12" Height="12"
                                                          IsActive="{Binding IsScraping}"
                                                          Visibility="{Binding IsScraping, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Border CornerRadius="8" Padding="6,1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Status, Converter={StaticResource ScrapingStatusColorConverter}}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="9"
                                                           ToolTipService.ToolTip="{Binding Status}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Title + year -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DisplayName}"
                                               Padding="6,4,6,2"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               MaxLines="2"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding FolderPath}" />

                                    <!-- Action buttons (always visible, no hover overlay) -->
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                HorizontalAlignment="Center"
                                                Padding="2,2,2,4">
                                        <Button Tag="{Binding}" Click="OnScrapeRowClick"
                                                Padding="8,3" MinWidth="0"
                                                ToolTipService.ToolTip="Scrape (or double-click the card)">
                                            <FontIcon Glyph="&#xE721;" FontSize="11" />
                                        </Button>
                                        <Button Tag="{Binding}" Click="OnOpenRowClick"
                                                Padding="8,3" MinWidth="0"
                                                ToolTipService.ToolTip="Open folder">
                                            <FontIcon Glyph="&#xE838;" FontSize="11" />
                                        </Button>
                                        <Button Tag="{Binding}" Click="OnRemoveRowClick"
                                                Padding="8,3" MinWidth="0"
                                                ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- List view (toggle) -->
                <ListView x:Name="MovieList"
                          SelectionMode="None"
                          ItemsSource="{Binding MovieFolders}"
                          Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="36,*,140,Auto">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="View details..." Click="OnContextViewDetailsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Search TMDb..." Click="OnContextScrapeClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open Folder" Click="OnContextOpenClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from List" Click="OnContextRemoveClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FolderPath}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding FolderPath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                    <ProgressRing Width="14" Height="14"
                                                  IsActive="{Binding IsScraping}"
                                                  Visibility="{Binding IsScraping, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border CornerRadius="10" Padding="8,2">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Status, Converter={StaticResource ScrapingStatusColorConverter}}" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold" FontSize="10" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Tag="{Binding}" Click="OnScrapeRowClick" Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                                            <TextBlock Text="Scrape" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{Binding}" Click="OnOpenRowClick" Padding="8,2"
                                            ToolTipService.ToolTip="Open folder">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    </Button>
                                    <Button Tag="{Binding}" Click="OnRemoveRowClick" Padding="8,2"
                                            ToolTipService.ToolTip="Remove from list">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty-state -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            Padding="24"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE721;" FontSize="56"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No movies in the list yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Add a movie folder, drop one onto the window, or come back from Step 2."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="380" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,4,0,0">
                <Button x:Name="SaveButton"
                        Content="Done"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>

        <!-- Drag-drop overlay -->
        <Border x:Name="DragOverlay"
                Background="#CC000000"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="56" Foreground="White" />
                <TextBlock Text="Drop folder to add"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
