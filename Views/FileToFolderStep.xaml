<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CineLibraryEssentials.Views.FileToFolderStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

        <!-- Output folder picker (single compact row) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Output"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Grid.Column="1"
                     x:Name="OutputFolderText"
                     IsReadOnly="True"
                     Text="{Binding OutputFolderPath, Mode=OneWay}"
                     PlaceholderText="No folder selected"
                     VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="BrowseButton"
                    Click="OnBrowseClick"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Change output folder">
                <FontIcon Glyph="&#xE838;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Side-by-side preview list -->
        <ListView Grid.Row="1"
                  x:Name="OperationsList"
                  SelectionMode="None"
                  ItemsSource="{Binding OperationsPreview}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="36,*,Auto,*"
                          Padding="10,8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <TextBlock Text="" />
                        <TextBlock Grid.Column="1" Text="Original"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="" />
                        <TextBlock Grid.Column="3" Text="Will Move To"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.Header>
                <Grid />
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="36,*,Auto,*">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OriginalFileName}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding OriginalFilePath}" />
                        <FontIcon Grid.Column="2"
                                  Glyph="&#xE72A;"
                                  FontSize="12"
                                  Margin="10,0"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding FinalFileName}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DestinationFolder}"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding DestinationFolder}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{Binding IsLoading}" Width="18" Height="18"
                              VerticalAlignment="Center" />
                <Button x:Name="RunButton"
                        Content="Run File to Folder"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnRunClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
