<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CineLibraryEssentials.Views.TmdbSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Search TMDb"
    PrimaryButtonText="Use Selected"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Width="600" Height="500">
        <!-- Search row -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="QueryBox"
                     PlaceholderText="Movie title..."
                     KeyDown="OnQueryKeyDown" />
            <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Content="Search"
                    Click="OnSearchClick" />
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1"
                   x:Name="StatusText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Results -->
        <ListView Grid.Row="2"
                  x:Name="ResultsList"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="12" Padding="6">
                        <Image Width="60" Height="90"
                               Stretch="UniformToFill"
                               Source="{Binding PosterImageUrl}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding TitleWithYear}"
                                       FontWeight="SemiBold"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding Overview}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
