<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CineLibraryEssentials.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About CineLibrary Essentials"
    CloseButtonText="Close"
    DefaultButton="Close">
    <StackPanel Spacing="14" Width="420">

        <!-- Icon + name -->
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
            <Image Width="48" Height="48"
                   Source="ms-appx:///Assets/AppIcon.ico"
                   VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="CineLibrary Essentials"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText"
                               Text="Version 1.0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="CheckUpdatesButton"
                                     Content="Check for updates"
                                     FontSize="12"
                                     Padding="0"
                                     Click="OnCheckUpdatesClick" />
                    <ProgressRing x:Name="UpdateProgress"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Width="14" Height="14"
                                  VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText"
                           Text=""
                           FontSize="11"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Description -->
        <TextBlock Text="Clean, organize, and enrich your movie library. Renames messy filenames, sorts each movie into its own Title (Year)/ folder, and downloads metadata, posters and actor photos from TMDb — fully Plex/Kodi/Jellyfin compatible."
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Links -->
        <StackPanel Spacing="2">
            <HyperlinkButton NavigateUri="https://aungkokomm.github.io/cinelibraryessentials/guide/"
                             Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE82D;" FontSize="14" />
                    <TextBlock Text="📖 User Guide" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton NavigateUri="https://aungkokomm.github.io/cinelibraryessentials/"
                             Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                    <TextBlock Text="🌐 Project page" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton x:Name="GitHubLink"
                             NavigateUri="https://github.com/aungkokomm/CineLibraryEssentials"
                             Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                    <TextBlock Text="GitHub repo · github.com/aungkokomm" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton NavigateUri="https://www.themoviedb.org/"
                             Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                    <TextBlock Text="Metadata by TMDb" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton NavigateUri="https://mkvtoolnix.download/"
                             Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                    <TextBlock Text="MKV cleanup powered by MKVToolNix (GPL v2)" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>

        <!-- Attributions -->
        <StackPanel Spacing="4">
            <TextBlock Text="This product uses the TMDb API but is not endorsed or certified by TMDb."
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Bundles mkvpropedit.exe from MKVToolNix (GPL v2) — see Tools/MKVToolNix/LICENSE.txt"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
