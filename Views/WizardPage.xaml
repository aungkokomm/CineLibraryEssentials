<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CineLibraryEssentials.Views.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryEssentials.Views">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,8,16,12">

        <!-- ========== Header row: step pills + About button ========== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="Step1Button"
                    Click="OnStep1Click"
                    Padding="14,4"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="Step1Bullet"
                            CornerRadius="10" Width="20" Height="20"
                            Background="{ThemeResource ControlFillColorTertiaryBrush}">
                        <TextBlock Text="1" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Clean Names" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <FontIcon Glyph="&#xE76C;" FontSize="10"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      VerticalAlignment="Center" />

            <Button x:Name="Step2Button"
                    Click="OnStep2Click"
                    Padding="14,4"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="Step2Bullet"
                            CornerRadius="10" Width="20" Height="20"
                            Background="{ThemeResource ControlFillColorTertiaryBrush}">
                        <TextBlock Text="2" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Organize" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <FontIcon Glyph="&#xE76C;" FontSize="10"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      VerticalAlignment="Center" />

            <Button x:Name="Step3Button"
                    Click="OnStep3Click"
                    Padding="14,4"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="Step3Bullet"
                            CornerRadius="10" Width="20" Height="20"
                            Background="{ThemeResource ControlFillColorTertiaryBrush}">
                        <TextBlock Text="3" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Scrape" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- About button -->
        <Button Grid.Column="1"
                Click="OnAboutClick"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="About CineLibrary Essentials">
            <FontIcon Glyph="&#xE946;" FontSize="14" />
        </Button>
        </Grid>

        <!-- ========== Step content (one of three is visible) ========== -->
        <Grid Grid.Row="1">
            <local:RenameStep x:Name="RenameStepView" />
            <local:FileToFolderStep x:Name="FileToFolderStepView" Visibility="Collapsed" />
            <local:ScrapingStep x:Name="ScrapingStepView" Visibility="Collapsed" />
        </Grid>

        <!-- ========== Wizard nav (Previous only — each step has its own primary button) ========== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="PreviousButton"
                    Content="← Back"
                    Click="OnPreviousClick" />
        </StackPanel>
    </Grid>
</Page>
