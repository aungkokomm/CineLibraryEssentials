<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CineLibraryEssentials.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryEssentials.Views"
    Title="CineLibrary Essentials">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="32,*,Auto">
        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*"
              Padding="12,0,0,0"
              Height="32">
            <Image Width="16" Height="16"
                   Source="ms-appx:///Assets/AppIcon.ico"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="CineLibrary Essentials"
                       Margin="10,0,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Content -->
        <Frame x:Name="ContentFrame" Grid.Row="1" />

        <!-- Toast host (notifications stack up at the bottom-right) -->
        <StackPanel x:Name="ToastHost"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="16,0,16,16"
                    MaxWidth="420"
                    Spacing="0" />
    </Grid>
</Window>
